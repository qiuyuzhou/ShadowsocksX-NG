        }
      }
    },
    "覆盖分析仅描述当前规则集合，不表示运行时已生效。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coverage analysis describes this rule collection; it does not indicate runtime activation."
